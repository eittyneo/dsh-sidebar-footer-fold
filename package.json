{
  "name": "dsh-sidebar-footer-fold",
  "version": "0.3.5",
  "description": "基于 dsh-cost-meter 的 DSH 侧栏增强插件：侧栏底部「费用面板 ▾/▸」折叠 dsh-cost-meter 的费用卡片、侧栏「更多 → 编辑侧栏…」、设置页「归档会话清理」（归档会话移入 Windows 回收站）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "cost-meter",
    "dsh-cost-meter",
    "session-manager"
  ],
  "author": "eittyneo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eittyneo/dsh-sidebar-footer-fold.git"
  },
  "homepage": "https://github.com/eittyneo/dsh-sidebar-footer-fold#readme",
  "bugs": {
    "url": "https://github.com/eittyneo/dsh-sidebar-footer-fold/issues"
  }
}
